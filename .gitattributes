# Normalize line endings so diffs stay clean across macOS/Windows contributors
* text=auto eol=lf

*.html  text diff=html
*.css   text diff=css
*.js    text
*.json  text
*.md    text diff=markdown
*.svg   text

# Treat binaries as binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
